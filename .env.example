# TapKit API (for local development with API key)
TAPKIT_API_KEY=tk_your_api_key_here
TAPKIT_API_URL=https://api.tapkit.ai/v1

# Supabase (for OAuth flow)
SUPABASE_URL=https://dlrtwwcgdfekjcyfqfcr.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_OAUTH_PROVIDER=google

# 32-byte key encoded as base64 or 64 hexadecimal characters.
# Generate one with: openssl rand -base64 32
OAUTH_ENCRYPTION_KEY=your_32_byte_encryption_key

# Random 16+ character secret used by Vercel to authorize the daily OAuth cleanup job.
CRON_SECRET=your_random_cron_secret

# MCP Server URL (for OAuth redirects)
MCP_SERVER_URL=https://mcp.tapkit.ai
MCP_RESOURCE_URL=https://mcp.tapkit.ai/mcp
MCP_SUPPORT_URL=https://www.tapkit.ai/support
MCP_PRIVACY_URL=https://www.tapkit.ai/privacy
MCP_TERMS_URL=https://www.tapkit.ai/terms
